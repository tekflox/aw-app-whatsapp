# Runtime scratch files
.tmp/
tmp/
temp/
*.log

# ui/dist IS committed: the release workflow runs tests only, never
# `npm run build`, so a gitignored bundle means the installed app points at a
# file that does not exist and its whole frontend silently vanishes.
!ui/dist/

# Generated at activation by whatsapp_app/self_register.py — it carries this
# workspace's API key. Committing it would leak the key AND pin another
# workspace's container hostname.
mcp.json
